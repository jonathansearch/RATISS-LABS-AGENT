# RATISS LABS AGENT — variables d'environnement
# Copier en .env et renseigner. Le .env n'est JAMAIS versionné (règle absolue n°1).
# Toutes les valeurs ci-dessous sont FACTICES ou des défauts de développement.
# Permissions recommandées : chmod 600 .env

# ── Socle A : PostgreSQL (checkpoints LangGraph, mémoire pgvector, événements) ──
# Utilisateur de la base de données.
POSTGRES_USER=ratiss
# Mot de passe PostgreSQL. OBLIGATOIRE : remplacer par une valeur forte unique.
POSTGRES_PASSWORD=change_moi
# Nom de la base principale.
POSTGRES_DB=ratiss
# Port publié sur 127.0.0.1 uniquement (administration depuis l'hôte).
POSTGRES_PORT=5432

# ── Socle A : Redis (états ContextForge étape C et LiteLLM étape B) ──
# Port publié sur 127.0.0.1 uniquement.
REDIS_PORT=6379

# ── Socle A : RustFS / stockage objet S3 (artefacts) ──
# Clé d'accès S3. OBLIGATOIRE : remplacer (valeur factice inspirée de la doc RustFS).
RUSTFS_ACCESS_KEY=rustfsadmin
# Secret S3. OBLIGATOIRE : remplacer par une valeur forte unique.
RUSTFS_SECRET_KEY=change_moi
# Port API S3 publié sur 127.0.0.1 uniquement.
RUSTFS_API_PORT=9000
# Port console web RustFS publié sur 127.0.0.1 uniquement (à ne jamais exposer au LAN en V1).
RUSTFS_CONSOLE_PORT=9001

# ── Étape B : Model Gateway (proxy LiteLLM, config/litellm.yaml) ──
# Clé d'authentification OBLIGATOIRE du proxy (le runtime l'utilise aussi, lue
# depuis son environnement au moment de l'appel — jamais dans le code).
LITELLM_MASTER_KEY=sk-change_moi
# Port du proxy publié sur 127.0.0.1 uniquement (administration/tests depuis l'hôte).
LITELLM_PORT=4000
# Port Ollama publié sur 127.0.0.1 uniquement (service optionnel, profil Docker "local").
OLLAMA_PORT=11434
# Adresse du proxy pour le runtime (défaut : http://llm-gateway:4000 sur le réseau Docker core).
# Surchargeable seulement si le proxy est déplacé — ne rien ajouter en V1 locale.
RATISS_LLM_PROXY_URL=http://llm-gateway:4000

# ── Décisions du chef (défauts proposés, modifiables sans toucher au code) ──
# Mot de passe UI, obligatoire dès que RATISS_LAN=1 (accès depuis le téléphone sur le réseau local).
RATISS_UI_PASSWORD=
# Accès LAN : 0 = UI/API sur 127.0.0.1 uniquement ; 1 = accessible depuis le réseau local (mot de passe requis).
RATISS_LAN=0
# Plafond de dépense modèle en USD par mois ; au-delà, les appels sont refusés (proposition : 10 ; à confirmer par le chef).
RATISS_BUDGET_USD=10
# Rétention des conversations en jours (le journal de provenance SHA-256 est conservé indéfiniment).
RATISS_RETENTION_JOURS=90
# Alias du modèle principal tel que déclaré dans config/litellm.yaml (étape B).
RATISS_MODELE=ratiss-principal

# ── Clés modèle (BYOK, étape B) — placeholders factices : ne JAMAIS mettre une vraie clé ici ──
# Clé API du fournisseur principal (alias ratiss-principal).
GLM_API_KEY=COLLEZ_VOTRE_CLE_ICI
# Clé API du fournisseur de secours (alias ratiss-secours).
DEEPSEEK_API_KEY=COLLEZ_VOTRE_CLE_ICI
