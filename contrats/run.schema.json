{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratiss-labs.dev/contrats/run.schema.json",
  "title": "Run",
  "description": "Exécution complète : plan, tasks, événements, artefacts, provenance. Un Run sans provenance n'existe pas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "status",
    "started_at",
    "plan",
    "tasks",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "running",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "manifest_sha256",
        "journal_sha256"
      ],
      "properties": {
        "engine": {
          "const": "RATISS-Framework"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "journal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "type": "string",
          "enum": [
            "in-toto",
            "ratiss-v1"
          ],
          "default": "ratiss-v1"
        }
      }
    },
    "total_cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "x-ratiss": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extensions RATISS (hors standard externe).",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
