{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratiss-labs.dev/contrats/task.schema.json",
  "title": "Task",
  "description": "Unité de travail planifiée par le control plane, exécutée par l'execution plane.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "status",
    "inputs",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste blanche des Tools utilisables (moindre privilège)."
    },
    "done_criteria": {
      "type": "string"
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "x-ratiss": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extensions RATISS (hors standard externe).",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
